<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>DataverseAuditManager.XrmToolBox</AssemblyName>
    <RootNamespace>DataverseAuditManager.XrmToolBox</RootNamespace>
    <Authors>KostasSavvopoulos</Authors>
    <Company>Pobuca</Company>
    <Copyright>Copyright 2026 Pobuca</Copyright>
    <Description>Inspect and manage Dataverse table and column auditing from XrmToolBox.</Description>
    <PackageId>Pobuca.DataverseAuditManager.XrmToolBox</PackageId>
    <PackageProjectUrl>https://github.com/pobuca/dataverse-audit-manager</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/pobuca/dataverse-audit-manager.git</RepositoryUrl>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.4.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MscrmTools.Xrm.Connection" Version="1.2025.9.64" />
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.10.74" />
  </ItemGroup>
</Project>
